{
  "name": "eduplatform",
  "version": "0.1.0",
  "private": true,
  "description": "A multi-tenant learning platform: each university its own ecosystem of classrooms, content, discussions, quizzes and grades.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "migrate": "node --env-file-if-exists=.env src/db/cli.js",
    "university": "node --env-file-if-exists=.env src/cli/university.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "pg": "^8.16.3"
  },
  "license": "MIT"
}
