# EduPlatform settings. Copy to .env and fill in what you need.
# Every one of these is optional for local development.

# ---- Database -------------------------------------------------------------
# The Supabase Postgres connection string. Leave it unset and the app runs an
# embedded Postgres under data/pgdata instead, which needs nothing installed.
#
# In Supabase: Project Settings -> Database -> Connection string -> URI. Use
# the pooled connection (port 6543) for a hosted deployment.
# DATABASE_URL=postgresql://postgres.abcdefgh:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# How many pooled connections to hold open. Supabase's free tier is small.
# DATABASE_POOL_MAX=10

# ---- Sessions -------------------------------------------------------------
# The key session cookies are signed with. MUST be set on any hosted
# deployment: without it a new key is generated on every restart, which signs
# everybody out. Any long random string will do.
# EDUPLATFORM_SESSION_SECRET=

# ---- Addresses ------------------------------------------------------------
# The origin people reach this app on. Render, Railway and Fly announce their
# own, so this is usually only needed elsewhere.
# PUBLIC_BASE_URL=https://eduplatform.example.edu

# HOST=0.0.0.0
# PORT=4000

# Force the Secure flag on cookies on or off. Normally inferred from whether
# the base URL is https, which is right almost always.
# EDUPLATFORM_SECURE_COOKIES=true

# ---- Storage --------------------------------------------------------------
# Where the embedded database and generated secrets live.
# EDUPLATFORM_DATA_DIR=./data
